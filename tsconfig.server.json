{
  // El servidor nunca se compila: Node 22 lo corre con --experimental-strip-types.
  // Esta config existe solo para que tsc lo revise (npm run check).
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["server/**/*.ts", "types.ts"]
}
